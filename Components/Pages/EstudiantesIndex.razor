@page "/Estudiantes/Index"
@rendermode InteractiveServer
@inject EstudiantesService estudianteService

<PageTitle>Registro de Estudiantes</PageTitle>

<div class="container">
    <div class="card shadow-lg">
        <div class="card-header">
            <h3>Registro de Estudiantes</h3>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <a href="/Estudiantes/Create" class="btn btn-success">
                        Crear Nuevo
                    </a>
                </div>
            </div>

            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombres</th>
                        <th>Email</th>
                        <th>Edad</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ListaEstudiantes)
                    {
                        <tr>
                            <td>@item.EstudianteId</td>
                            <td>@item.Nombres</td>
                            <td>@item.Email</td>
                            <td>@item.Edad</td>
                            <td>
                                <a href="/Estudiantes/Edit/@item.EstudianteId" class="btn btn-outline-primary btn-sm">
                                    Editar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            <p>Total de registros: @ListaEstudiantes.Count</p>
        </div>
    </div>
</div>

@code {
    public List<Estudiante> ListaEstudiantes { get; set; } = new List<Estudiante>();

    protected override async Task OnInitializedAsync()
    {
        ListaEstudiantes = await estudianteService.Listar(e => true);
    }
}